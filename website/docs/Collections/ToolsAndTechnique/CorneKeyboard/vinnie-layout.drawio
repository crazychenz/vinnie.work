        <mxCell id="IRgN7K5Qah6Z3UlPxJiG-1" value="- Red is bad when L1 held in L0.&lt;div&gt;&lt;br&gt;&lt;div&gt;- We duplicate &amp;lt;, and &amp;gt;. for number formating without switch.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Auto-Shift required.&lt;/b&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;Otherwise we&#39;d need to break out the symbols from first row.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;spacingLeft=10;verticalAlign=bottom;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="710" y="252.81" width="180" height="200" as="geometry" />
        </mxCell>
        <mxCell id="IRgN7K5Qah6Z3UlPxJiG-2" value="- Red is bad when L2 held in L0.&lt;div&gt;&lt;br&gt;&lt;div&gt;- &lt;i&gt;Back and Fwd likely unused.&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- L,R,U,D keys match VIM keys.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Vol -+ align with &amp;lt; and &amp;gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- PgUp/Dn match Vol-= alignment AND PgUp above PgDn.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;spacingLeft=10;verticalAlign=bottom;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="710" y="502.80999999999995" width="180" height="237.19" as="geometry" />
        </mxCell>
        <mxCell id="IRgN7K5Qah6Z3UlPxJiG-3" value="- Mouse and NumPad Layer, &lt;b&gt;Always locked in&lt;/b&gt;.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;i&gt;Wh-Left/Right likely unused.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Numpad includes all numpad buttons.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;spacingLeft=10;verticalAlign=bottom;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="710" y="810" width="180" height="157.19" as="geometry" />
        </mxCell>
        <mxCell id="IRgN7K5Qah6Z3UlPxJiG-4" value="- Auto-Shift Assumed.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Must use L1 or L2 for Ctl+Atl+Del.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Special keys selected for sentence formatting.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;spacingLeft=10;verticalAlign=bottom;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="710" y="20" width="180" height="150" as="geometry" />
